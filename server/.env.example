NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skybox-drive?retryWrites=true&w=majority
JWT_SECRET=skybox_ultra_secret_jwt_key_2026_super_secure
JWT_EXPIRES_IN=7d
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage_data
DEFAULT_USER_QUOTA=104857600
CORS_ORIGIN=*

